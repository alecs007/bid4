# ---------------------------------------------------------------------------
# bid4 frontend — environment
# Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# THE swap switch. `true` (default) serves everything from lib/mock via
# lib/api/*. Set to `false` to talk to the real Spring Boot backend instead.
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the Spring Boot API — served from the root, not under /api.
# Only used when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Shows the dev-only role switcher and seed-account quick login.
# Forced off in production builds regardless of this value.
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# The public origin, used for canonical URLs and social cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
