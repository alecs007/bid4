# bid4 — local infrastructure secrets. Copy to `.env`; never commit `.env`.
# Regenerate every value below before anything leaves a laptop.

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=bid4
POSTGRES_USER=bid4
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=bid4-minio
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_BUCKET_PUBLIC=bid4-public
MINIO_BUCKET_PRIVATE=bid4-private

# --- Backend --------------------------------------------------------------
# HMAC key for access tokens. At least 32 bytes, base64-encoded:
#   openssl rand -base64 48
BID4_JWT_SECRET=replace-with-openssl-rand-base64-48
BID4_CORS_ORIGINS=http://localhost:3000
